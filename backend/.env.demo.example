NODE_ENV=production
PORT=4000
MONGODB_URI=mongodb+srv://DEMO_DB_USER:URL_ENCODED_PASSWORD@DEMO_CLUSTER/supermarket_pos_demo?retryWrites=true&w=majority
JWT_ACCESS_SECRET=generate-a-separate-random-secret-at-least-48-bytes-long
CORS_ORIGINS=https://demo.example.com
FRONTEND_ORIGIN=https://demo.example.com
COOKIE_SECURE=true

# All four values are required for one-click demo access.
DEMO_MODE=true
DEMO_DATABASE_NAME=supermarket_pos_demo
DEMO_DATABASE_ID=generate-a-unique-random-identity-at-least-16-characters
DEMO_ACCOUNT_PASSWORD=generate-a-random-password-at-least-16-characters
